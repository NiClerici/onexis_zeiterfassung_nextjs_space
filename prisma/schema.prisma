generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  // Erzwingt beim nächsten Login das Setzen eines neuen Passworts, das die
  // aktuelle Passwortrichtlinie erfüllt. Wird von der Migration für alle
  // Bestandsnutzer auf true gesetzt (deren password-Hash aus der alten
  // Code-Ära stammt); frische Registrierungen starten mit false.
  mustSetPassword Boolean @default(false)
  language      String    @default("de")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  timeEntries      TimeEntry[]
  pensumChanges    PensumChange[]
  overtimePayouts  OvertimePayout[]
  passwordResetTokens PasswordResetToken[]
  memberships      Membership[]
  monthLocks       MonthLock[]
  customerMonths   CustomerMonth[]
  absenceRequests  AbsenceRequest[]
}

model PensumChange {
  id          String   @id @default(cuid())
  userId      String
  orgId       String
  pensum      Float
  weeklyHours Float
  effectiveFrom DateTime @db.Date
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveFrom])
  @@index([orgId])
}

// Mandantenfähigkeit (MIGRATION.md Punkt 3). Slug ist der öffentliche,
// URL-taugliche Bezeichner (z.B. für künftige Einladungslinks).
model Organization {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  plan           String    @default("trial") // trial | starter | pro
  trialEndsAt    DateTime?
  maxWeeklyHours Float     @default(45) // 45 oder 50 (Art. 12/13 ArG, Punkt 6a)
  createdAt      DateTime  @default(now())

  // Nicht-blockierende ArG-Warnungen im Kalender pro Organisation
  // abschaltbar. Sonntagsarbeit ist per Default AUS: sie ist zwar
  // bewilligungspflichtig (Art. 18 ArG), Betriebe mit Bewilligung oder in
  // ausgenommenen Branchen sehen sonst bei jedem Sonntagseintrag eine
  // Meldung, die für sie keine ist.
  warnPauseZuKurz    Boolean @default(true)
  warnSonntagsarbeit Boolean @default(false)

  memberships     Membership[]
  timeEntries     TimeEntry[]
  customers       Customer[]
  projects        Project[]
  pensumChanges   PensumChange[]
  overtimePayouts OvertimePayout[]
  invitations     Invitation[]
  holidays        Holiday[]
  monthLocks      MonthLock[]
  absenceRequests AbsenceRequest[]
  customerMonths  CustomerMonth[]
}

// Monatsabschluss (MIGRATION.md Punkt 6e). Existenz einer Zeile = der Monat
// ist für diesen Nutzer aktuell gesperrt (member: read-only, siehe
// lib/access.ts assertMonthEditable()). admin/owner sperren und entsperren
// über /api/month-locks; ein Entsperren LÖSCHT diese Zeile wieder (kein
// "unlocked"-Flag hier) — der Verlauf beider Aktionen bleibt stattdessen in
// MonthLockAudit erhalten, s.u.
model MonthLock {
  id       String   @id @default(cuid())
  orgId    String
  userId   String
  year     Int
  month    Int      // 1-12
  lockedAt DateTime @default(now())
  lockedBy String   // userId der sperrenden Person — bewusst keine Relation (gleiches Muster wie TimeEntryAudit.changedBy)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, year, month])
  @@index([orgId, userId])
}

// Unveränderlicher Verlauf aller Sperr-/Entsperr-Aktionen (MIGRATION.md
// Punkt 6e, "was im Audit-Trail landet") — eigene Tabelle statt Wieder-
// verwendung von TimeEntryAudit, weil ein Monatsabschluss kein Feld-Diff
// eines einzelnen TimeEntry ist, sondern ein Ereignis auf (orgId, userId,
// year, month). Bleibt bestehen, auch wenn die zugehörige MonthLock-Zeile
// beim Entsperren gelöscht wird — sonst ginge "wer hat wann entsperrt"
// verloren. Keine Relation auf User (gleiches Muster wie TimeEntryAudit).
model MonthLockAudit {
  id          String   @id @default(cuid())
  orgId       String
  userId      String
  year        Int
  month       Int
  action      String   // "locked" | "unlocked"
  performedBy String
  performedAt DateTime @default(now())

  @@index([orgId, userId, year, month])
}

// Absenzantrag mit Genehmigung (MIGRATION.md Punkt 9). type ist auf
// tatsächliche Absenztypen beschränkt (ferien|krank|militaer|unbezahlt —
// nicht arbeit/feiertag, siehe lib/absence-entries.ts ABSENCE_TYPES).
// decidedBy ist bewusst keine Relation (gleiches Muster wie
// TimeEntryAudit.changedBy) — der Entscheid bleibt nachvollziehbar, auch
// wenn der entscheidende Account später gelöscht wird.
model AbsenceRequest {
  id        String    @id @default(cuid())
  orgId     String
  userId    String
  fromDate  DateTime  @db.Date
  toDate    DateTime  @db.Date
  type      String
  status    String    @default("offen") // offen | genehmigt | abgelehnt
  comment   String?
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime  @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([userId])
}

// Feiertage pro Organisation (MIGRATION.md Punkt 6c). Kein fixer
// Basissatz-Zwang im Schema — der Schweizer Basissatz und kantonale
// Feiertage werden über lib/holidays.ts generiert und als normale Zeilen
// geschrieben ("Seed"); canton dokumentiert nur die Herkunft (null =
// Basissatz) und lässt sich beliebig um eigene, manuell erfasste Feiertage
// ergänzen ("auswählbar und ergänzbar").
model Holiday {
  id      String   @id @default(cuid())
  orgId   String
  date    DateTime @db.Date
  name    String
  canton  String?
  halfDay Boolean  @default(false)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, date, name])
  @@index([orgId, date])
}

// Einladung eines neuen Mitglieds per E-Mail (MIGRATION.md Punkt 4). Nur der
// Hash des Tokens wird gespeichert — analog zu PasswordResetToken. 7 Tage
// gültig, einmal verwendbar (usedAt). invitedByUserId trägt keine Relation
// mit onDelete: Cascade auf User, damit eine Einladung nachvollziehbar
// bleibt, auch wenn der einladende Account später gelöscht wird.
model Invitation {
  id             String    @id @default(cuid())
  orgId          String
  email          String
  role           String    @default("member") // admin | manager | member — owner wird nie eingeladen
  tokenHash      String    @unique
  invitedByUserId String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
}

// Verbindet einen User mit einer Organization. Trägt auch die
// Arbeitseinstellungen (gehören fachlich zur Anstellung, nicht zur Person —
// derselbe Mensch kann später in zwei Organisationen unterschiedliche
// Pensen haben). managerId ist eine Selbstreferenz auf eine andere
// Membership derselben Organisation (der Vorgesetzte).
model Membership {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      String   @default("member") // owner | admin | manager | member
  managerId String?
  status    String   @default("aktiv")  // aktiv | inaktiv
  entryDate DateTime @db.Date
  exitDate  DateTime? @db.Date

  // Arbeitseinstellungen — von User hierher verschoben (MIGRATION.md Punkt 3a).
  weeklyHours     Float     @default(42)
  pensum          Float     @default(100)
  // Werte, die vor der ersten Pensumsänderung galten (Basis für rückwirkende Berechnungen)
  baseWeeklyHours Float?
  basePensum      Float?
  vacationDays    Float     @default(25)
  startDate       DateTime?
  // Kürzel für den Stundenrapport-Export (z.B. "CLN") — frei pflegbar im
  // Profil, keine Ableitungslogik aus dem Namen (nicht immer eindeutig).
  kuerzel         String?
  stdHoursMon     Float     @default(0)
  stdHoursTue     Float     @default(0)
  stdHoursWed     Float     @default(0)
  stdHoursThu     Float     @default(0)
  stdHoursFri     Float     @default(0)
  stdHoursSat     Float     @default(0)
  stdHoursSun     Float     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager  Membership?   @relation("MembershipManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports  Membership[]  @relation("MembershipManager")

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([managerId])
}

// Signierter, einmal verwendbarer Token für den Passwort-Reset per E-Mail.
// Nur der Hash wird gespeichert — der Klartext-Token existiert ausschliesslich
// im Link, der per Mail verschickt wird.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Rate-Limiting für /api/auth/* (Login, Passwort-vergessen, Passwort-Reset) in
// der DB statt im Speicher, weil die App potenziell mehrfach läuft.
// action unterscheidet die Endpunkte ("login" | "forgot-password" |
// "reset-password"); email ist bei nicht-email-bezogenen Aktionen leer.
model LoginAttempt {
  id        String   @id @default(cuid())
  action    String   @default("login")
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([action, email, createdAt])
  @@index([action, ip, createdAt])
}

model TimeEntry {
  id         String   @id @default(cuid())
  userId     String
  orgId      String
  date       DateTime @db.Date
  hours      Float?
  type       String   @default("arbeit")
  von        String?
  bis        String?
  pauseMin   Int      @default(0)
  notiz      String?
  customerId String?
  projectId  String?
  // true = zählt zu Soll/Ist/Überzeit (kennzahlen() in lib/calc.ts) — der
  // bisherige, einzige Zustand. false = reine Projekt-/Kundenzuordnung ohne
  // Wirkung auf die Arbeitszeit-Kennzahlen, aber weiterhin wirksam für alles
  // Projekt-/Kundenbezogene (Verrechnungsgrad, Projektstunden, Export).
  // Nur der Stundenrapport-Import (app/api/import/stundenrapport/route.ts)
  // setzt hier bewusst false, damit migrierte Alt-Zuordnungen die parallel
  // schon erfasste, echte Arbeitszeit desselben Tages nicht verdoppeln.
  // Sobald jemand die Zeile aktiv im Tagesdialog speichert, setzt
  // PUT /api/time-entries dieses Feld wieder auf true ("Graduierung").
  countsAsWorktime Boolean @default(true)
  // Soft-Delete statt Hard-Delete (MIGRATION.md Punkt 6b) — die gesetzliche
  // Aufbewahrungspflicht von 5 Jahren verlangt, dass gelöschte Einträge
  // rekonstruierbar bleiben. Alle lesenden Queries filtern auf deletedAt: null.
  deletedAt  DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([orgId, date])
  @@index([projectId])
}

// Feldweises Änderungs- und Löschprotokoll für TimeEntry (MIGRATION.md
// Punkt 6b) — ohne das ist die gesetzliche Aufbewahrungspflicht von 5 Jahren
// nicht erfüllt und der Export bei einer Kontrolle durch das
// Arbeitsinspektorat wertlos. Kein FK auf TimeEntry/User: der Audit-Trail
// muss auch dann noch lesbar sein, wenn ein Account später gelöscht wird
// (gleiches Muster wie Invitation.invitedByUserId) — entryId/changedBy sind
// bewusst reine IDs ohne Relation/Cascade.
model TimeEntryAudit {
  id        String   @id @default(cuid())
  entryId   String
  orgId     String
  changedBy String
  changedAt DateTime @default(now())
  field     String
  oldValue  String?
  newValue  String?

  @@index([entryId])
  @@index([orgId, changedAt])
}

// Kunden gehören der Organisation, nicht dem einzelnen Mitarbeitenden
// (MIGRATION.md Punkt 3) — deshalb kein userId mehr, nur noch orgId.
model Customer {
  id        String      @id @default(cuid())
  orgId     String
  name      String
  // Fallback-Stundensatz, falls ein Projekt dieses Kunden keinen eigenen
  // hourlyRate trägt (MIGRATION.md Punkt 5).
  hourlyRate Float?
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]
  projects  Project[]
  customerMonths CustomerMonth[]

  @@unique([orgId, name])
}

// Projekte als Entität statt Freitext (MIGRATION.md Punkt 5) — erst dadurch
// gibt es Budgets und Stundensätze pro Projekt statt nur pro Kunde.
model Project {
  id          String   @id @default(cuid())
  orgId       String
  customerId  String
  name        String
  hourlyRate  Float?
  budgetHours Float?
  // SAP-/Auftragsnummer des Kunden. Erscheint im Projektkatalog des
  // Stundenrapport-Exports als "<externalRef> | <name>" (Vorlage:
  // "00000000000000068440TTO | Phys. Schutz UW (0015524)"). NULL = nur der Name.
  externalRef String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  createdBy   String?  // userId der erstellenden Person — bewusst keine Relation
                        // (gleiches Muster wie TimeEntryAudit.changedBy), NULL bei
                        // Bestandsprojekten vor dieser Migration. Macht ein von
                        // einem "member" frisch angelegtes Projekt für diesen
                        // sichtbar, bevor er selbst Stunden darauf gebucht hat
                        // (siehe GET /api/projects).

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]
  customerMonths CustomerMonth[]

  @@unique([orgId, customerId, name])
  @@index([orgId])
}

// Kundenstunden pro Monat statt pro Tag (Betrieb.md-Nachtrag, 18.08.2026) —
// Nico erfasst sie separat vom Arbeitszeit-Eintrag, nicht mehr über
// customerId/projectId/billable an TimeEntry (diese Felder bleiben dort
// erhalten, werden aber nicht mehr beschrieben — Rückfalloption, falls die
// Migration der Bestandsdaten etwas übersieht). Optional auf ein Projekt
// des Kunden aufteilbar (projectId), sonst gilt die Zeile dem Kunden direkt.
//
// Kein @@unique auf (orgId, userId, year, month, customerId, projectId):
// in PostgreSQL gelten zwei NULL-Werte in einem Unique-Index als
// verschieden, ein solcher Constraint würde also mehrere Zeilen ohne
// projectId für denselben Kunden/Monat NICHT verhindern. Die Eindeutigkeit
// wird deshalb in app/api/customer-months/route.ts geprüft (dort wird pro
// Monat ohnehin der komplette Zeilensatz ersetzt, nicht einzeln
// hinzugefügt) — hier bewusst kein Constraint, der nicht hält, was er
// verspricht.
model CustomerMonth {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  year       Int
  month      Int      // 1-12
  customerId String
  projectId  String?
  hours      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project  Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([orgId, year, month])
  @@index([userId, year, month])
}

model OvertimePayout {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  date      DateTime @db.Date
  hours     Float
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([orgId, date])
}
