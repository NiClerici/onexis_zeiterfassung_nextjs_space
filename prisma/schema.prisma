generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  // Erzwingt beim nächsten Login das Setzen eines neuen Passworts, das die
  // aktuelle Passwortrichtlinie erfüllt. Wird von der Migration für alle
  // Bestandsnutzer auf true gesetzt (deren password-Hash aus der alten
  // Code-Ära stammt); frische Registrierungen starten mit false.
  mustSetPassword Boolean @default(false)
  language      String    @default("de")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  timeEntries      TimeEntry[]
  pensumChanges    PensumChange[]
  overtimePayouts  OvertimePayout[]
  passwordResetTokens PasswordResetToken[]
  memberships      Membership[]
}

model PensumChange {
  id          String   @id @default(cuid())
  userId      String
  orgId       String
  pensum      Float
  weeklyHours Float
  effectiveFrom DateTime @db.Date
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveFrom])
  @@index([orgId])
}

// Mandantenfähigkeit (MIGRATION.md Punkt 3). Slug ist der öffentliche,
// URL-taugliche Bezeichner (z.B. für künftige Einladungslinks).
model Organization {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  plan           String    @default("trial") // trial | starter | pro
  trialEndsAt    DateTime?
  maxWeeklyHours Float     @default(45) // 45 oder 50 (Art. 12/13 ArG, Punkt 6a)
  createdAt      DateTime  @default(now())

  memberships     Membership[]
  timeEntries     TimeEntry[]
  customers       Customer[]
  projects        Project[]
  pensumChanges   PensumChange[]
  overtimePayouts OvertimePayout[]
  invitations     Invitation[]
  holidays        Holiday[]
}

// Feiertage pro Organisation (MIGRATION.md Punkt 6c). Kein fixer
// Basissatz-Zwang im Schema — der Schweizer Basissatz und kantonale
// Feiertage werden über lib/holidays.ts generiert und als normale Zeilen
// geschrieben ("Seed"); canton dokumentiert nur die Herkunft (null =
// Basissatz) und lässt sich beliebig um eigene, manuell erfasste Feiertage
// ergänzen ("auswählbar und ergänzbar").
model Holiday {
  id      String   @id @default(cuid())
  orgId   String
  date    DateTime @db.Date
  name    String
  canton  String?
  halfDay Boolean  @default(false)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, date, name])
  @@index([orgId, date])
}

// Einladung eines neuen Mitglieds per E-Mail (MIGRATION.md Punkt 4). Nur der
// Hash des Tokens wird gespeichert — analog zu PasswordResetToken. 7 Tage
// gültig, einmal verwendbar (usedAt). invitedByUserId trägt keine Relation
// mit onDelete: Cascade auf User, damit eine Einladung nachvollziehbar
// bleibt, auch wenn der einladende Account später gelöscht wird.
model Invitation {
  id             String    @id @default(cuid())
  orgId          String
  email          String
  role           String    @default("member") // admin | manager | member — owner wird nie eingeladen
  tokenHash      String    @unique
  invitedByUserId String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
}

// Verbindet einen User mit einer Organization. Trägt auch die
// Arbeitseinstellungen (gehören fachlich zur Anstellung, nicht zur Person —
// derselbe Mensch kann später in zwei Organisationen unterschiedliche
// Pensen haben). managerId ist eine Selbstreferenz auf eine andere
// Membership derselben Organisation (der Vorgesetzte).
model Membership {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      String   @default("member") // owner | admin | manager | member
  managerId String?
  status    String   @default("aktiv")  // aktiv | inaktiv
  entryDate DateTime @db.Date
  exitDate  DateTime? @db.Date

  // Arbeitseinstellungen — von User hierher verschoben (MIGRATION.md Punkt 3a).
  weeklyHours     Float     @default(42)
  pensum          Float     @default(100)
  // Werte, die vor der ersten Pensumsänderung galten (Basis für rückwirkende Berechnungen)
  baseWeeklyHours Float?
  basePensum      Float?
  vacationDays    Float     @default(25)
  startDate       DateTime?
  stdHoursMon     Float     @default(0)
  stdHoursTue     Float     @default(0)
  stdHoursWed     Float     @default(0)
  stdHoursThu     Float     @default(0)
  stdHoursFri     Float     @default(0)
  stdHoursSat     Float     @default(0)
  stdHoursSun     Float     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager  Membership?   @relation("MembershipManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports  Membership[]  @relation("MembershipManager")

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([managerId])
}

// Signierter, einmal verwendbarer Token für den Passwort-Reset per E-Mail.
// Nur der Hash wird gespeichert — der Klartext-Token existiert ausschliesslich
// im Link, der per Mail verschickt wird.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Rate-Limiting für /api/auth/* (Login, Passwort-vergessen, Passwort-Reset) in
// der DB statt im Speicher, weil die App potenziell mehrfach läuft.
// action unterscheidet die Endpunkte ("login" | "forgot-password" |
// "reset-password"); email ist bei nicht-email-bezogenen Aktionen leer.
model LoginAttempt {
  id        String   @id @default(cuid())
  action    String   @default("login")
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([action, email, createdAt])
  @@index([action, ip, createdAt])
}

model TimeEntry {
  id         String   @id @default(cuid())
  userId     String
  orgId      String
  date       DateTime @db.Date
  hours      Float?
  type       String   @default("arbeit")
  von        String?
  bis        String?
  pauseMin   Int      @default(0)
  notiz      String?
  customerId String?
  projectId  String?
  // Verrechenbar — beim Anlegen aus Projekt/Kunde vorbelegt (customer.billable),
  // im Tagesdialog überschreibbar. Ersetzt die frühere Kunden-Lookup-Liste in
  // kennzahlen() (MIGRATION.md Punkt 5).
  billable   Boolean  @default(false)
  // Soft-Delete statt Hard-Delete (MIGRATION.md Punkt 6b) — die gesetzliche
  // Aufbewahrungspflicht von 5 Jahren verlangt, dass gelöschte Einträge
  // rekonstruierbar bleiben. Alle lesenden Queries filtern auf deletedAt: null.
  deletedAt  DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([orgId, date])
  @@index([projectId])
}

// Feldweises Änderungs- und Löschprotokoll für TimeEntry (MIGRATION.md
// Punkt 6b) — ohne das ist die gesetzliche Aufbewahrungspflicht von 5 Jahren
// nicht erfüllt und der Export bei einer Kontrolle durch das
// Arbeitsinspektorat wertlos. Kein FK auf TimeEntry/User: der Audit-Trail
// muss auch dann noch lesbar sein, wenn ein Account später gelöscht wird
// (gleiches Muster wie Invitation.invitedByUserId) — entryId/changedBy sind
// bewusst reine IDs ohne Relation/Cascade.
model TimeEntryAudit {
  id        String   @id @default(cuid())
  entryId   String
  orgId     String
  changedBy String
  changedAt DateTime @default(now())
  field     String
  oldValue  String?
  newValue  String?

  @@index([entryId])
  @@index([orgId, changedAt])
}

// Kunden gehören der Organisation, nicht dem einzelnen Mitarbeitenden
// (MIGRATION.md Punkt 3) — deshalb kein userId mehr, nur noch orgId.
model Customer {
  id        String      @id @default(cuid())
  orgId     String
  name      String
  billable  Boolean     @default(true)
  // Fallback-Stundensatz, falls ein Projekt dieses Kunden keinen eigenen
  // hourlyRate trägt (MIGRATION.md Punkt 5).
  hourlyRate Float?
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]
  projects  Project[]

  @@unique([orgId, name])
}

// Projekte als Entität statt Freitext (MIGRATION.md Punkt 5) — erst dadurch
// gibt es Budgets und Stundensätze pro Projekt statt nur pro Kunde.
model Project {
  id          String   @id @default(cuid())
  orgId       String
  customerId  String
  name        String
  hourlyRate  Float?
  budgetHours Float?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@unique([orgId, customerId, name])
  @@index([orgId])
}

model OvertimePayout {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  date      DateTime @db.Date
  hours     Float
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([orgId, date])
}
