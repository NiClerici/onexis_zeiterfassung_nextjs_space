# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Datenbank ---
# Nur für lokale Entwicklung/manuelles Deployment direkt gesetzt — im
# Docker-Compose-Setup (docker-compose.yml, deploy/README.md) wird
# DATABASE_URL stattdessen automatisch aus POSTGRES_* unten
# zusammengesetzt und zeigt auf den "db"-Service, nicht auf diesen Wert.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# --- Auth (NextAuth) ---
# Zufälliges Secret generieren, z.B.: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-random-secret-here"
# Muss die tatsächlich erreichbare URL sein — ohne NEXTAUTH_URL (oder mit
# falschem Port) warnt NextAuth und die Anmeldung verhält sich unzuverlässig
# (siehe MIGRATION.md Punkt 1, Notizen). Produktiv: https://<deine-domain>.
NEXTAUTH_URL="http://localhost:3000"

# --- SMTP für Passwort-Reset-Mails (lib/mail.ts) ---
# Bewusst KEIN US-Dienst (kein SendGrid, Postmark, Resend) — Default hier:
# Infomaniak, ein Schweizer Anbieter. Ohne SMTP_HOST/SMTP_USER/
# SMTP_PASSWORD wird die Mail nur ins Server-Log geschrieben, nicht
# verschickt (praktisch für lokale Entwicklung, siehe Punkt 2).
SMTP_HOST="mail.infomaniak.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ONEXIS Zeiterfassung <no-reply@example.ch>"

# --- Developer-Übersicht (/dev, lib/dev-access.ts) ---
# Kommagetrennte Allowlist von E-Mail-Adressen mit Zugriff auf die
# plattformweite Betreibersicht (alle Organisationen). Fail-closed: leer
# oder ungesetzt heisst NIEMAND hat Zugriff, /dev liefert dann 404. Kein
# Rollen-Flag (Membership.role), weil der Zugriff org-übergreifend ist.
DEVELOPER_EMAILS="du@example.ch"

# --- Nur für Docker Compose (docker-compose.yml, deploy/README.md) ---
# Diese vier Variablen werden von next dev/next start NICHT gelesen — sie
# steuern ausschliesslich den PostgreSQL- und Caddy-Container. DATABASE_URL
# oben wird im Compose-Setup ignoriert und stattdessen aus POSTGRES_* neu
# zusammengesetzt (siehe docker-compose.yml, Service "app").
POSTGRES_DB="zeiterfassung"
POSTGRES_USER="zeiterfassung"
POSTGRES_PASSWORD="generate-a-strong-password-here"
# Domain, auf die Caddy automatisch ein TLS-Zertifikat holt (Let's
# Encrypt) — DNS muss vorher auf die VM zeigen, Port 80+443 offen sein.
DOMAIN="zeit.deine-firma.ch"
