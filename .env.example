# Copy this file to .env and fill in your values
# NEVER commit .env to version control

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# SMTP für Passwort-Reset-Mails (lib/mail.ts). Bewusst KEIN US-Dienst
# (kein SendGrid, Postmark, Resend) — Default hier: Infomaniak.
# Ohne SMTP_HOST/SMTP_USER/SMTP_PASSWORD wird die Mail nur ins Server-Log
# geschrieben, nicht verschickt (praktisch für lokale Entwicklung).
SMTP_HOST="mail.infomaniak.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ONEXIS Zeiterfassung <no-reply@example.ch>"
